# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored and must never be shared or committed.

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Your Angel One login PIN/MPIN
ANGEL_PIN=
# The text secret shown under the QR code when you enabled TOTP
ANGEL_TOTP_SECRET=
# Optional: your public IPv4 (the one registered on the SmartAPI app). Auto-detected if empty.
ANGEL_PUBLIC_IP=

# Supabase (Project Settings → API). The service_role key is secret: worker only, never the website.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database connection for migrations (Supabase -> Connect -> Session pooler URI).
# Keep [YOUR-PASSWORD] in the URI and put the password below; it is filled in automatically.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Supabase personal access token for deploying Edge Functions (Account -> Access Tokens)
SUPABASE_ACCESS_TOKEN=
